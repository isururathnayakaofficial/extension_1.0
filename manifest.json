{
  "manifest_version": 3,
  "name": "Task Focus Blocker",
  "version": "1.0",
  "description": "Blocks distracting websites during your scheduled tasks.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8081/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtu.be/*",
    "*://youtube-nocookie.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://linkedin.com/*",
    "*://*.linkedin.com/*",
    "*://pinterest.com/*",
    "*://*.pinterest.com/*",
    "*://snapchat.com/*",
    "*://*.snapchat.com/*",
    "*://threads.net/*",
    "*://*.threads.net/*",
    "*://discord.com/*",
    "*://*.discord.com/*",
    "*://messenger.com/*",
    "*://*.messenger.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}